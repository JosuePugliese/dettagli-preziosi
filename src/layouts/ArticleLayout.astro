---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    date: string;
    author: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} description={frontmatter.description}>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
    <!-- Article Header -->
    <header class="text-center pb-12 mb-12 border-b border-stone-200/80">
      <div
        class="flex items-center justify-center gap-3 text-xs tracking-widest uppercase text-stone-500 mb-6"
      >
        <time datetime={frontmatter.date}>{frontmatter.date}</time>
        <span aria-hidden="true">&bull;</span>
        <span>Di {frontmatter.author}</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-serif text-stone-900 leading-tight tracking-tight"
      >
        {frontmatter.title}
      </h1>
    </header>

    <!-- Markdown Content Container -->
    <div
      class="prose prose-stone max-w-none text-stone-800 leading-relaxed space-y-6 [&_h2]:text-2xl [&_h2]:font-serif [&_h2]:text-stone-900 [&_h2]:mt-12 [&_h2]:mb-4 [&_p]:font-light [&_p]:text-base sm:[&_p]:text-lg [&_strong]:font-medium [&_strong]:text-stone-950 [&_a]:text-stone-900 [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-stone-600"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
