---
import BaseLayout from "../layouts/BaseLayout.astro";

// Usa la funzione nativa di Vite, che è più sicura e aggiornata
const posts = Object.values(import.meta.glob("./*.mdx", { eager: true }));
---

<BaseLayout>
  <main class="max-w-5xl mx-auto px-6 py-16">
    {/* Sezione Hero (Intestazione) */}
    <section class="text-center mb-16">
      <h1 class="text-5xl font-bold text-charcoal-900 mb-4">
        L'arte del dettaglio quotidiano
      </h1>
      <p class="text-lg text-gray-600">
        Scopri le migliori alternative accessibili al lusso per i tuoi gioielli
        e accessori.
      </p>
    </section>

    {/* Griglia dinamica degli articoli */}
    <section>
      <h2 class="text-2xl font-bold mb-8 text-charcoal-800">
        Le Ultime Recensioni
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          posts.map((post) => (
            <a
              href={post.url}
              class="group block bg-white border border-gray-100 rounded-2xl p-5 shadow-sm hover:shadow-md hover:border-rose-400 transition-all duration-300"
            >
              {/* Box immagine (per ora segnaposto grigio/rosa) */}
              <div class="bg-rose-50 w-full h-48 rounded-xl mb-4 flex items-center justify-center">
                <span class="text-rose-400 font-medium">Foto Articolo</span>
              </div>

              {/* Dati letti dinamicamente dal frontmatter del tuo .mdx */}
              <h3 class="text-xl font-semibold text-charcoal-900 group-hover:text-rose-500 transition-colors">
                {post.frontmatter.title}
              </h3>
              <p class="text-sm text-gray-500 mt-3">
                {post.frontmatter.date} • {post.frontmatter.author}
              </p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
