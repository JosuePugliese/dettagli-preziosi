---
interface Props {
  title: string;
  brand: string;
  price: string;
  imageUrl: string;
  affiliateUrl: string;
}

const { title, brand, price, imageUrl, affiliateUrl } = Astro.props;
---

<article
  class="group bg-white border border-stone-200/80 rounded-none overflow-hidden flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:shadow-stone-200/50 hover:border-stone-300"
>
  <div>
    <!-- Image Container -->
    <div class="relative aspect-square w-full overflow-hidden bg-stone-100">
      <img
        src={imageUrl}
        alt={`${brand} - ${title}`}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
      />
      <div
        class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-2.5 py-1"
      >
        <span
          class="text-[10px] font-semibold tracking-widest uppercase text-stone-600 block"
        >
          {brand}
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="p-6">
      <h3
        class="text-lg font-serif text-stone-900 leading-snug line-clamp-2 group-hover:text-stone-700 transition-colors"
      >
        {title}
      </h3>
      <p class="mt-3 text-lg font-light text-stone-900 tracking-tight">
        {price}
      </p>
    </div>
  </div>

  <!-- CTA Action -->
  <div class="px-6 pb-6 pt-2">
    <a
      href={affiliateUrl}
      target="_blank"
      rel="nofollow sponsored"
      class="w-full inline-flex items-center justify-center gap-2 bg-stone-900 text-white text-xs font-medium uppercase tracking-widest py-3.5 px-6 hover:bg-stone-800 active:bg-stone-950 transition-colors duration-200"
    >
      <span>Vedi Offerta</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-1"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </div>
</article>
